<resources>
    <!--
      Guardian Flow palette.
      Indigo carries trust and structure, emerald means "safe / active",
      amber is a warning that needs attention but not alarm, red is danger only.
    -->

    <!-- Primary — Indigo -->
    <color name="primary">#4F46E5</color>
    <color name="primary_dark">#3525CD</color>
    <color name="primary_container">#E2DFFF</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="on_primary_container">#0F0069</color>

    <!-- Secondary — Emerald. Used for anything that means "protected / on". -->
    <color name="secondary">#10B981</color>
    <color name="secondary_dark">#006C49</color>
    <color name="secondary_container">#6CF8BB</color>
    <color name="on_secondary">#FFFFFF</color>
    <color name="on_secondary_container">#00714D</color>

    <!-- Tertiary — Amber. Warnings and time limits. -->
    <color name="tertiary">#F59E0B</color>
    <color name="tertiary_container">#FFDDB8</color>
    <color name="on_tertiary">#FFFFFF</color>
    <color name="on_tertiary_container">#653E00</color>

    <!-- Error -->
    <color name="error">#BA1A1A</color>
    <color name="error_container">#FFDAD6</color>
    <color name="on_error">#FFFFFF</color>
    <color name="on_error_container">#93000A</color>

    <!-- Surfaces -->
    <color name="background">#F8F9FF</color>
    <color name="surface">#F8F9FF</color>
    <color name="surface_card">#FFFFFF</color>
    <color name="surface_container_low">#EFF4FF</color>
    <color name="surface_container">#E5EEFF</color>
    <color name="surface_container_high">#DCE9FF</color>
    <color name="surface_variant">#D3E4FE</color>

    <!-- Text -->
    <color name="on_surface">#0B1C30</color>
    <color name="on_surface_variant">#464555</color>
    <color name="outline">#777587</color>
    <color name="outline_variant">#C7C4D8</color>

    <color name="white">#FFFFFFFF</color>
    <color name="black">#FF000000</color>

    <!-- Adaptive icon background — white so it matches the artwork's own tile. -->
    <color name="ic_launcher_background">#FFFFFF</color>
</resources>
