<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light-only on purpose: every screen hardcodes light backgrounds and dark
         text, so a DayNight parent would render dark-on-dark in night mode. -->
    <style name="Theme.BeaverGuardian" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/brand_blue_dark</item>
    </style>
</resources>
