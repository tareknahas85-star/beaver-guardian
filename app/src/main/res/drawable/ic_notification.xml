<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification small icon — MUST be monochrome white on transparent background.
    Android 5+ ignores color; only alpha channel is used.
    Simple shield outline so it reads well at small sizes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Shield silhouette (filled white, system tints it) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 L21,6 L21,12 C21,17.5 17,21.5 12,23 C7,21.5 3,17.5 3,12 L3,6 Z" />

    <!-- Eye cut-out (transparent window inside shield) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M12,10 A3,2 0 1,0 12.001,10 Z" />

</vector>
