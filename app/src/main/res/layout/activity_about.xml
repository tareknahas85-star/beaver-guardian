<?xml version="1.0" encoding="utf-8"?>
<!-- The app theme is *.NoActionBar, so this screen supplies its own toolbar.
     AboutActivity calls setSupportActionBar(toolbar) to get the back arrow. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="About / حول"
        app:titleTextColor="#FFFFFF"
        app:navigationIconTint="#FFFFFF" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- ── App icon ── -->
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App icon" />

        <!-- ── User display name ── -->
        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ولي الأمر"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface" />

        <!-- ── Role subtitle ── -->
        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ولي الأمر — Parent"
            android:textSize="14sp"
            android:textColor="#555577"
            android:layout_marginBottom="20dp" />

        <!-- ── E-Signature card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التوقيع الإلكتروني / E-signature"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_gravity="end"
                    android:layout_marginBottom="4dp" />

                <!-- SignaturePad wrapper: FrameLayout lets hint overlay the drawing area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp">

                    <!-- Drawing pad — user draws signature with finger -->
                    <com.github.gcacace.signaturepad.views.SignaturePad
                        android:id="@+id/signaturePad"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@color/surface_card"
                        app:penColor="@color/primary"
                        app:penMinWidth="4dp"
                        app:penMaxWidth="8dp" />

                    <!-- Hint: visible when pad is empty, hidden as soon as user starts signing -->
                    <TextView
                        android:id="@+id/tvSignatureHint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✍  وقّع هنا / Sign here"
                        android:textColor="@color/outline"
                        android:textSize="15sp"
                        android:background="@drawable/border_signature_hint"
                        android:clickable="false"
                        android:focusable="false" />

                    <!-- Saved signature preview (shown instead of pad when signature exists) -->
                    <ImageView
                        android:id="@+id/ivSignaturePreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@color/surface_card"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Saved signature" />

                </FrameLayout>

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <!-- Shown only in PREVIEW mode: switch to the drawing pad -->
                    <Button
                        android:id="@+id/btnEditSignature"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تعديل / Edit"
                        android:textColor="@color/primary" />

                    <!-- Shown only in DRAWING mode: back to the official signature -->
                    <Button
                        android:id="@+id/btnClearSignature"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح / Clear"
                        android:textColor="@color/error"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnSaveSignature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حفظ / Save"
                        android:backgroundTint="@color/primary"
                        android:layout_marginStart="8dp"
                        android:visibility="gone" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Contact info card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="معلومات التواصل / Contact"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface"
                    android:layout_marginBottom="12dp" />

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✉  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="tareknahas85@gmail.com"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/outline_variant" android:layout_marginBottom="10dp" />

                <!-- GitHub -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔗  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="github.com/tareknahas85-star"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/outline_variant" android:layout_marginBottom="10dp" />

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📞  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="+963 945 830 002"
                        android:textSize="14sp"
                        android:textColor="@color/on_surface" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/outline_variant" android:layout_marginBottom="10dp" />

                <!-- LinkedIn — confirmed profile, opens in browser on tap -->
                <LinearLayout
                    android:id="@+id/rowLinkedIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💼  " android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvLinkedIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="linkedin.com/in/tarek-nahas-669322382"
                        android:textSize="14sp"
                        android:textColor="#0077B5" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── App info card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SafeGuard — Beaver Guardian"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>

</LinearLayout>
