<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- ── App icon ── -->
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="App icon" />

        <!-- ── User display name ── -->
        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ولي الأمر"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E" />

        <!-- ── Role subtitle ── -->
        <TextView
            android:id="@+id/tvRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ولي الأمر — Parent"
            android:textSize="14sp"
            android:textColor="#555577"
            android:layout_marginBottom="20dp" />

        <!-- ── E-Signature card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التوقيع الإلكتروني / E-signature"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_gravity="end"
                    android:layout_marginBottom="4dp" />

                <!-- SignaturePad wrapper: FrameLayout lets hint overlay the drawing area -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="160dp">

                    <!-- Drawing pad — user draws signature with finger -->
                    <com.github.gcacace.signaturepad.views.SignaturePad
                        android:id="@+id/signaturePad"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="#FFFFFF"
                        app:penColor="#1565C0"
                        app:penMinWidth="4dp"
                        app:penMaxWidth="8dp" />

                    <!-- Hint: visible when pad is empty, hidden as soon as user starts signing -->
                    <TextView
                        android:id="@+id/tvSignatureHint"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="✍  وقّع هنا / Sign here"
                        android:textColor="#BBBBBB"
                        android:textSize="15sp"
                        android:background="@drawable/border_signature_hint"
                        android:clickable="false"
                        android:focusable="false" />

                    <!-- Saved signature preview (shown instead of pad when signature exists) -->
                    <ImageView
                        android:id="@+id/ivSignaturePreview"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="#FFFFFF"
                        android:scaleType="fitCenter"
                        android:visibility="gone"
                        android:contentDescription="Saved signature" />

                </FrameLayout>

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnClearSignature"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسح / Clear"
                        android:textColor="#E91E63" />

                    <Button
                        android:id="@+id/btnSaveSignature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حفظ / Save"
                        android:backgroundTint="#1565C0"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Contact info card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="معلومات التواصل / Contact"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:layout_marginBottom="12dp" />

                <!-- Email -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✉  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="tareknahas85@gmail.com"
                        android:textSize="14sp"
                        android:textColor="#1A1A2E" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0E0E0" android:layout_marginBottom="10dp" />

                <!-- GitHub -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔗  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="github.com/tareknahas85-star"
                        android:textSize="14sp"
                        android:textColor="#1A1A2E" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0E0E0" android:layout_marginBottom="10dp" />

                <!-- Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="10dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📞  " android:textSize="16sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="+963 945 830 002"
                        android:textSize="14sp"
                        android:textColor="#1A1A2E" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#E0E0E0" android:layout_marginBottom="10dp" />

                <!-- LinkedIn — TODO: verify profile URL for Tarek Nahas (tareknahas85).
                     A public LinkedIn profile matching github.com/tareknahas85-star was not found
                     during automated search. Replace the URL below once confirmed. -->
                <LinearLayout
                    android:id="@+id/rowLinkedIn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💼  " android:textSize="16sp" />
                    <TextView
                        android:id="@+id/tvLinkedIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="linkedin.com/in/tareknahas85"
                        android:textSize="14sp"
                        android:textColor="#0077B5" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── App info card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SafeGuard — Beaver Guardian"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.0"
                    android:textSize="13sp"
                    android:textColor="#888888" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
