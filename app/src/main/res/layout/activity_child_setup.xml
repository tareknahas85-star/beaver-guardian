<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/child_notice"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/etPairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/pair_code"
            android:inputType="textCapCharacters"
            android:autofillHints="off"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair device"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permission steps"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button android:id="@+id/btnPermUsage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1) Usage access" />
        <Button android:id="@+id/btnPermAccessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2) Accessibility service (app blocking)" />
        <Button android:id="@+id/btnPermOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3) Display over other apps" />
        <Button android:id="@+id/btnPermLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4) Location + calls + contacts + notifications" />
        <Button android:id="@+id/btnPermAdmin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="5) Enable device admin" />
        <Button android:id="@+id/btnStartVpn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="6) Start the internet filter" />

        <Button
            android:id="@+id/btnPermCallScreening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="7) Call filtering permission" />

        <TextView
            android:id="@+id/tvCallScreeningStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/on_tertiary_container"
            android:paddingStart="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvProtectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/secondary_dark"
            android:paddingStart="4dp"
            android:paddingBottom="16dp" />

        <!-- ═══ SOS ═══ Always reachable, deliberately large and unmissable. -->
        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:text="🆘  SOS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="@color/error"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sends your location and an instant alert to your parent"
            android:textSize="11sp"
            android:textColor="@color/on_surface_variant"
            android:paddingTop="4dp" />
    </LinearLayout>
</ScrollView>
