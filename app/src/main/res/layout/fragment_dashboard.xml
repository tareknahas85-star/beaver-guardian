<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="20dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Alerts blocked warning -->
        <LinearLayout android:id="@+id/boxNotifWarning"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_warning_card"
            android:padding="14dp" android:layout_marginBottom="14dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Notifications are off" android:textStyle="bold"
                android:textSize="15sp" android:textColor="@color/on_tertiary_container" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="SOS and unknown callers will not reach you."
                android:textSize="13sp" android:textColor="@color/on_tertiary_container"
                android:paddingTop="4dp" android:paddingBottom="8dp" />
            <Button android:id="@+id/btnFixNotif" style="@style/Button.Primary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Turn notifications on" />
        </LinearLayout>

        <!-- Status: location + connection -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:padding="18dp" android:gravity="center_vertical">
                <TextView android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_pill_emerald" android:gravity="center"
                    android:text="📍" android:textSize="20sp" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layout_marginStart="12dp">
                    <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Current location" />
                    <TextView android:id="@+id/tvLocation" style="@style/Text.Title"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Unknown" />
                    <TextView android:id="@+id/tvZoneState" style="@style/Text.Caption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="end">
                    <TextView android:id="@+id/tvConnection" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:textStyle="bold" android:textColor="@color/secondary_dark"
                        android:text="—" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="Connection" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Daily screen time ring -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Daily screen time" />
                <TextView android:id="@+id/tvLimit" style="@style/Text.Caption"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingBottom="10dp" />
                <FrameLayout android:layout_width="180dp" android:layout_height="180dp"
                    android:layout_gravity="center">
                    <com.microbeaver.guardian.widget.ProgressRingView android:id="@+id/ring"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="vertical" android:layout_gravity="center"
                        android:gravity="center">
                        <TextView android:id="@+id/tvUsedTotal" style="@style/Text.Metric"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0m" android:textSize="26sp" />
                        <TextView android:id="@+id/tvRemaining" style="@style/Text.Caption"
                            android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </FrameLayout>
                <TextView android:id="@+id/tvTopApps" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="14dp"
                    android:text="Waiting for the child device…" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick actions -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Quick actions"
                    android:paddingBottom="10dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <Button android:id="@+id/btnLock" style="@style/Button.Primary"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Lock" />
                    <Button android:id="@+id/btnUnlock" style="@style/Button.Safe"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Unlock"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="10dp">
                    <Button android:id="@+id/btnNetOff" style="@style/Button.Outline"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Pause internet" />
                    <Button android:id="@+id/btnNetOn" style="@style/Button.Outline"
                        android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="Resume"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Recent activity -->
        <androidx.cardview.widget.CardView style="@style/Card.Guardian"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/Text.SectionLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Recent activity" />
                <TextView android:id="@+id/tvFeed" style="@style/Text.Body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="14sp" android:paddingTop="10dp" android:text="Nothing yet" />
                <Button android:id="@+id/btnTestNotif" style="@style/Button.Text"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Send a test notification" android:paddingStart="0dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
